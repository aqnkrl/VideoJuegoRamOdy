  m_Script: {fileID: 11500000, guid: b4c4b500cd110084486bd94a6cfab7b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoPersonaje
  panelDialogo: {fileID: 1129029686}
  textoDialogo: {fileID: 1677145397}
  textoNombre: {fileID: 0}
  botonSiguiente: {fileID: 1825753301}
  textoBoton: {fileID: 615545853}
  nombrePersonaje: Personaje
  lineas:
  - "\xA1Hola! Ahora toca cuidar el descanso de Ody y de Ram\xF3n."
  - "Las barras sobre cada uno muestran su comida, su agua y su sue\xF1o."
  - Llena sus platos para subir la comida y el agua.
  - "Cuando tengan sue\xF1o, acu\xE9stalos en su cama: Ram\xF3n con E (se mueve con
    W, A, S, D) y Ody con O (se mueve con las flechas)."
  - "Para levantarlos, solo mu\xE9velos otra vez. \xA1Cu\xEDdalos mucho!"
  iniciarAlComenzar: 1
  velocidadLetra: 0.03
  teclaContinuar: 32
  textoSiguiente: Siguiente
  textoUltimo: "\xA1Entendido!"
  bloquearMovimiento: 1
  perros: []
  desaparecerAlTerminar: 1
  conFundido: 1
  duracionFundido: 0.8
  alTerminar:
    m_PersistentCalls:
      m_Calls: []
  objetosQueDesaparecen: []
